#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    /* Combinación automática para la Capa 3 al presionar Lower + Raise */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
&mt LSHFT CAPS  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                              &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RALT
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp TAB         &none  &none    &kp UP    &none     &none        &kp KP_PLUS  &kp N7    &kp N8     &kp N9  &kp KP_ASTERISK  &kp BSPC
&mt LSHFT CAPS  &none  &kp LEFT &kp DOWN  &kp RIGHT &none        &kp KP_MINUS &kp N4    &kp N5     &kp N6  &kp KP_SLASH     &kp EQUAL
&kp LCTRL       &none  &none    &none     &none     &none        &none N0     &kp N1    &kp N2     &kp N3  &kp KP_DOT       &kp BACKSLASH
                                &kp LGUI  &trans    &kp SPACE    &kp RALT     &trans    &kp RALT
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp TILDE  &kp AT    &kp HASH  &kp LPAR  &kp RPAR  &kp PRCNT    &none    &kp F7   &kp F8   &kp F9   &kp F10  &none
&kp CARET  &kp DLLR  &kp AMPS  &kp LBKT  &kp RBKT  &kp MINUS    &none    &kp F4   &kp F5   &kp F6   &kp F11  &none
&none      &none     &none     &kp LBRC  &kp RBRC  &kp UNDER    &none    &kp F1   &kp F2   &kp F3   &kp F12  &none
                               &kp LGUI  &trans    &kp SPACE    &kp RET  &trans   &kp RALT
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&none  &none  &none  &none    &none  &none        &kp C_VOL_UP  &none       &none     &none       &none  &none
&none  &none  &none  &none    &none  &none        &kp C_VOL_DN  &kp C_PREV  &kp C_PP  &kp C_NEXT  &none  &none
&none  &none  &none  &none    &none  &none        &kp C_MUTE    &none       &none     &none       &none  &none
                     &kp LGUI &trans &kp SPACE    &kp RET       &trans      &kp RALT
            >;
        };

        /* Capas reservadas para compatibilidad con ZMK Studio */
        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };
    };
};